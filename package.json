{
  "name": "crane",
  "version": "0.1.0",
  "description": "An autonomous software factory you steer. Agents maintain and evolve codebases; you stay in control.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crane": "./bin/crane.js"
  },
  "files": [
    "bin/",
    "dist/",
    "web/dist/"
  ],
  "workspaces": [
    "web",
    "packages/contracts",
    "packages/agent-protocol",
    "packages/agent-policy",
    "packages/worktree-deps",
    "packages/agent-drivers"
  ],
  "bundledDependencies": ["@crane/contracts", "@crane/agent-protocol", "@crane/agent-policy", "@crane/worktree-deps", "@crane/agent-drivers"],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "concurrently -k -n packages,factory,web -c blue,yellow,cyan \"npm:dev:packages\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:packages": "node scripts/check-workspace-links.mjs && tsc -b tsconfig.packages.json --watch",
    "predev:server": "npm run build:packages",
    "dev:server": "tsx watch src/cli/index.ts serve --port 4471",
    "dev:web": "npm run dev -w web",
    "build:packages": "node scripts/check-workspace-links.mjs && tsc -b tsconfig.packages.json",
    "build:backend": "esbuild \"src/**/*.ts\" --outdir=dist --outbase=src --platform=node --format=esm --target=es2022 --sourcemap --log-level=warning",
    "build": "node scripts/build.mjs",
    "prepack": "npm run typecheck && npm run build",
    "typecheck": "npm run build:packages && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && npm run typecheck -w web",
    "pretest": "npm run build:packages",
    "test": "node --import tsx --test test/*.test.ts",
    "precrane": "npm run build:packages",
    "crane": "tsx src/cli/index.ts",
    "screenshot": "node --import tsx scripts/screenshot.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@crane/agent-drivers": "0.1.0",
    "@crane/agent-policy": "0.1.0",
    "@crane/agent-protocol": "0.1.0",
    "@crane/contracts": "0.1.0",
    "@crane/worktree-deps": "0.1.0",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "hono": "^4.13.14",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "concurrently": "^9.2.1",
    "esbuild": "~0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
