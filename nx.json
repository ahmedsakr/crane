{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "useDaemonProcess": false,
  "neverConnectToCloud": true,
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.packages.json",
      "{workspaceRoot}/tsconfig.checks.json",
      "{workspaceRoot}/tsconfig.test.json",
      "{workspaceRoot}/.gitignore",
      "{workspaceRoot}/scripts/build.mjs",
      "{workspaceRoot}/scripts/check-workspace-links.mjs",
      "{workspaceRoot}/scripts/nx-toolchain.mjs",
      { "runtime": "node scripts/nx-toolchain.mjs" },
      { "env": "NODE_OPTIONS" },
      { "env": "NODE_ENV" }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "checksDeclarations": [
      "{workspaceRoot}/scripts/**/*.d.ts",
      "{workspaceRoot}/scripts/**/*.d.mts",
      "{workspaceRoot}/scripts/**/*.d.cts",
      "{workspaceRoot}/test/**/*.d.ts",
      "{workspaceRoot}/test/**/*.d.mts",
      "{workspaceRoot}/test/**/*.d.cts"
    ]
  }
}
