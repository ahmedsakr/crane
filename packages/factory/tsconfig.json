{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../agent-drivers"
    },
    {
      "path": "../agent-policy"
    },
    {
      "path": "../agent-protocol"
    },
    {
      "path": "../backend-runtime"
    },
    {
      "path": "../contracts"
    },
    {
      "path": "../diagnostics"
    },
    {
      "path": "../storage"
    },
    {
      "path": "../worktree-deps"
    }
  ]
}
