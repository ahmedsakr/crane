{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@crane/factory",
  "projectType": "library",
  "tags": [
    "kind:package"
  ],
  "implicitDependencies": [
    "@crane/agent-drivers",
    "@crane/agent-policy",
    "@crane/agent-protocol",
    "@crane/backend-runtime",
    "@crane/contracts",
    "@crane/diagnostics",
    "@crane/storage",
    "@crane/worktree-deps"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-workspace-links.mjs && tsc -b packages/factory/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:noop",
      "dependsOn": [
        "build"
      ]
    }
  }
}
