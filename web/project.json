{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "@crane/web",
  "projectType": "application",
  "tags": ["kind:web"],
  "implicitDependencies": ["@crane/contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../scripts/check-workspace-links.mjs && vite build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../scripts/check-workspace-links.mjs && tsc -p tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "outputs": [],
      "cache": true
    }
  }
}
